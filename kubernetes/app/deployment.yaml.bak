apiVersion: apps/v1
kind: Deployment
metadata:
  name: acmecloud-app
  namespace: acmecloud
  labels:
    app: acmecloud-app
    app.kubernetes.io/name: acmecloud-app
    app.kubernetes.io/part-of: acmecloud-enterprise-platform
spec:
  replicas: 2
  selector:
    matchLabels:
      app: acmecloud-app
  template:
    metadata:
      labels:
        app: acmecloud-app
        app.kubernetes.io/name: acmecloud-app
        app.kubernetes.io/part-of: acmecloud-enterprise-platform
    spec:
      imagePullSecrets:
        - name: ecr-registry
      containers:
        - name: app
          image: 944777361548.dkr.ecr.us-east-1.amazonaws.com/acmecloud-app:v3
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
